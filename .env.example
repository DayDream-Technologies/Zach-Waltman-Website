# Public site. Only the Function URL is exposed to the browser.
# Leave it blank until the Lambda in server/lambda is deployed.
# While it is blank, the donate page links to the family GoFundMe instead.
VITE_DONATION_FUNCTION_URL=

# --- Lambda: server/lambda/create-checkout-session ---
# Stripe secret key. Use the test key until the foundation is ready for live gifts.
STRIPE_SECRET_KEY=
# Public site origin, no trailing slash. Used for Checkout success and cancel URLs.
SITE_URL=http://localhost:5173
# Browser origin allowed to call the Function URL. Use the real site origin in production.
ALLOWED_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Edge Functions (stripe-webhook, send-receipt) ---
# Signing secret from the Stripe webhook endpoint. Payments stay "pending" until this is set.
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
# Example: Zach Waltman Foundation <receipts@your-domain.org>
RECEIPT_FROM=
# Must be the charity's legal name and EIN before any receipt is sent.
# send-receipt refuses to email while EIN is empty or contains PENDING.
LEGAL_NAME=Zach Waltman Foundation
EIN=PENDING
